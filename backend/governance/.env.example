# ============================================================
# NATIONAL MATERIAL MASTER & GOVERNANCE ENGINE
# Environment Configuration Example
# ============================================================
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/national_material_master
# For sync Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:changeme@localhost:5432/national_material_master

# ---------- JWT ----------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Application ----------
APP_ENV=development
APP_DEBUG=false
APP_TITLE=National Material Master Governance API
APP_VERSION=1.0.0

# ---------- Security ----------
# Argon2 password hashing is used automatically
# Minimum password length
MIN_PASSWORD_LENGTH=12

# ---------- Rate Limiting ----------
# Max login attempts per minute per IP
LOGIN_RATE_LIMIT=5

# ---------- CORS ----------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- First Admin (seeder only) ----------
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_EMAIL=admin@national-material-master.gov.in
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12chars
ADMIN_NAME=System Administrator
