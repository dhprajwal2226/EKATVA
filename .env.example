# Environment Configuration for Core AI Material Intelligence Engine
# SIH 2026 - National Material Master Platform for CPSEs

PROJECT_NAME="National Material Master AI Engine"
VERSION="1.0.0"
API_V1_STR="/api"

DATABASE_URL="sqlite:///./ekatva_materials.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/ekatva_db"
DB_ECHO=false

SEMANTIC_WEIGHT=0.30
FUZZY_WEIGHT=0.20
ATTRIBUTE_WEIGHT=0.30
TECHNICAL_WEIGHT=0.20

CANDIDATE_TOP_K=25
MIN_CANDIDATE_SCORE=0.35

IDENTICAL_THRESHOLD=0.94
NEAR_DUPLICATE_THRESHOLD=0.82
FUNCTIONAL_EQUIVALENT_THRESHOLD=0.72
REVIEW_THRESHOLD=0.60

CRITICAL_CONFLICT_BEHAVIOR="DO_NOT_AUTO_MERGE"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
MAX_UPLOAD_SIZE_BYTES=52428800
